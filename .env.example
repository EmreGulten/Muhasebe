# Bu dosyayı .env olarak kopyalayın ve değerleri kendi ortamınıza göre düzenleyin:
#   cp .env.example .env
# .env dosyası sürüm kontrolüne girmez (.gitignore).

# PostgreSQL
POSTGRES_DB=accounting
POSTGRES_USER=accounting
POSTGRES_PASSWORD=guclu-bir-parola-secin

# JWT — gizli anahtar üretmek için: openssl rand -base64 48
# En az 32 karakter olmalı; üretime özel rastgele bir değer kullanın.
JWT_SECRET=
JWT_ISSUER=accounting-api
JWT_AUDIENCE=accounting-web

# AI Asistan (opsiyonel) — API anahtarı boş bırakılırsa asistan offline modda
# çalışır: dış ağa istek çıkmaz, sorular onaylı iş araçlarından gerçek
# verilerle yanıtlanır. Anahtar girilirse OpenAI uyumlu bir sağlayıcı kullanılır.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_MONTHLY_QUESTION_LIMIT=100

# Portlar (isteğe bağlı)
API_PORT=5000
WEB_PORT=3000
